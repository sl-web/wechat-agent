# ===== 敏感配置(只放 .env,不进代码/数据库)=====

# LLM 供应商(OpenAI 兼容接口)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=qwen3.6-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
# 单次 LLM 请求超时(秒),默认 420;模型无响应时按此上限报错,而不是无限等待
LLM_TIMEOUT=420
# 思考模式(思维链):auto / on / off
# 实测 qwen3.6-plus 的思考阶段占掉整次生成约 90% 的时间(输出 9589 tokens 里
# 约 8000 个是不返回给用户的隐藏推理,首字要等 148 秒);关掉后 165 秒 → 19 秒。
# auto(默认)= 只在识别为 DashScope/Qwen 时关闭;换了别的供应商请设 on,
# 因为 enable_thinking 是供应商特有参数,对不支持的下发可能直接报 400。
LLM_THINKING=auto

# 数据源 API 授权(可选;未配置自动降级爬虫模式)
WECHAT_API_KEY=
WECHAT_API_SECRET=
DOUYIN_API_KEY=

# 通知渠道(可选)
SERVERCHAN_KEY=
WECOM_WEBHOOK=

# 运行目录(默认项目内 data/)
DATA_DIR=./data
